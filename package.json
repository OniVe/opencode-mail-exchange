{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-mail-exchange",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin: Exchange mailbox tools (EWS, NTLM), calendar and contacts",
  "type": "module",
  "license": "MIT",
  "author": "OniVe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OniVe/opencode-mail-exchange.git"
  },
  "homepage": "https://github.com/OniVe/opencode-mail-exchange#readme",
  "bugs": {
    "url": "https://github.com/OniVe/opencode-mail-exchange/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "exchange",
    "ews",
    "mail",
    "calendar",
    "contacts",
    "ntlm"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "README.ru.md",
    "risks.md",
    "docs/roadmap.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@opencode/plugin": "2.0.26",
    "@types/bun": "^1.2.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@ewsjs/xhr": "3.1.3",
    "ews-javascript-api": "0.15.3"
  }
}
